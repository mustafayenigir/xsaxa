<?xml version="1.0" encoding="utf-8"?>
<!-- iPhone AssistiveTouch benzeri: koyu yuvarlak köşeli kare + iç içe daireler -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3262626" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:inset="9dp">
        <shape android:shape="oval">
            <solid android:color="#E6E0E0E0" />
        </shape>
    </item>
    <item android:inset="15dp">
        <shape android:shape="oval">
            <solid android:color="#B3262626" />
        </shape>
    </item>
    <item android:inset="19dp">
        <shape android:shape="oval">
            <solid android:color="#E6E0E0E0" />
        </shape>
    </item>
</layer-list>
