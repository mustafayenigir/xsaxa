<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/cBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Canlı başlık bandı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <Button
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/settings_title"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:text="@string/home_greeting"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <!-- V2 deneme: sabit Zoom toplantısı -->
        <LinearLayout
            android:id="@+id/zoomCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zoom_title"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/zoom_desc"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/zoomJoin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                android:text="@string/zoom_join"
                android:textColor="?attr/cAccentText"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- WEB SİTELERİ: logo kutucukları -->
        <TextView
            style="@style/SettingsHint"
            android:layout_marginTop="12dp"
            android:text="@string/site_hint" />

        <GridLayout
            android:id="@+id/siteGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="4" />

        <TextView
            android:id="@+id/siteMessage"
            style="@style/SettingsHint"
            android:visibility="gone" />

        <Button
            android:id="@+id/siteRefresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/site_refresh" />

        <!-- TEMANI SEÇ -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/section_palette" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/palette_hint" />

        <GridLayout
            android:id="@+id/paletteGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2" />

        <TextView
            android:id="@+id/paletteDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/on_background"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/palette_note" />

        <!-- AYARLAR -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/section_settings" />

        <!-- SES -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/section_audio" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchKeepAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_audio_title"
            android:textColor="@color/on_background"
            android:textSize="16sp" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/keep_audio_desc" />

        <Button
            android:id="@+id/batteryButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/battery_button" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/battery_hint" />

        <!-- REKLAM ENGELLEME -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/section_ads" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAdBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ad_block_title"
            android:textColor="@color/on_background"
            android:textSize="16sp" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/ad_block_desc" />

        <!-- GÖRÜNÜM -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/section_theme" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_system"
                android:textColor="@color/on_background" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_light"
                android:textColor="@color/on_background" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_dark"
                android:textColor="@color/on_background" />
        </RadioGroup>

        <!-- YAZI BOYUTU -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/section_font" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/zoomMinus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="A−" />

            <SeekBar
                android:id="@+id/zoomSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/zoomPlus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="A+" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="%100"
                android:textColor="@color/on_background"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/zoomReset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/font_reset" />
        </LinearLayout>

        <TextView
            android:id="@+id/zoomPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/font_preview"
            android:textColor="@color/on_background"
            android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
