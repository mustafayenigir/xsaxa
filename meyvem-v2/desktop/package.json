{
  "name": "meyvem-v2",
  "productName": "Meyvem V2",
  "version": "1.0.0",
  "description": "Meyvem - şifre kilitli site görüntüleyici",
  "main": "main.js",
  "author": "Meyvem",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.scjegitim.meyvem.v2",
    "productName": "Meyvem V2",
    "artifactName": "MeyvemV2.exe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "adblock.js",
      "renderer/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    }
  }
}
